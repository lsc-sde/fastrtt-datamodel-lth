# SQLMesh settings
MSSQL_HOST="***"
MSSQL_DATABASE="pathways"
MSSQL_CONCURRENT_TASKS=8

# SQL authentication. Leave both unset to use Windows authentication instead
# (on a Mac, get a Kerberos ticket with `kinit -f` first).
# MSSQL_USER=""
# MSSQL_PASSWORD=""

MSSQL_STATE_HOST="***"
MSSQL_STATE_DATABASE="***"

DEFAULT_GATEWAY="mssql"
# SQLMESH_DEBUG="false"

STATE_SCHEMA="pathways_sqlmesh_state"

START_DATE="2024-01-01 00:00:00"

# Source database settings
# Database holding dbo.incomplete_ptl. Prefix the linked server when it is on
# another server than MSSQL_HOST, e.g. LTHDSDEV.[18_Weeks] from LTHDATASCIENCE.
DB_PTL="LTHDSDEV.[18_Weeks]"

# Catalog and schema of the OMOP master patient index (stg__master_patient_index),
# used to link PTL MRNs to OMOP person_id. Three parts if it is on the same server
# as MSSQL_HOST, four (linked server first) if not.
DB_MPI="dbt_omop.prod"
